# ==============================================================================
# TRACEX – DIGITAL FORENSICS & CYBER INVESTIGATION SUITE
# Environment Configuration Template (.env.example)
# NOTE: All API keys and credentials must be provided by the local examiner (BYOK).
# Never commit real credentials or private keys to source control.
# ==============================================================================

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKBENCH_DEPLOYMENT_MODE=workstation
WORKBENCH_API_KEY=

# Local Mode Policy (When True, strictly blocks all external outbound queries)
LOCAL_ONLY_MODE=true

# Maximum Individual Evidence Upload Size (in MB, default: 200)
MAX_UPLOAD_SIZE_MB=200

# Forensic Storage Paths
DATA_DIR=analysis_workspace
REPORTS_DIR=reports
RULES_DIR=rules
DB_PATH=analysis_workspace/workbench.db

# Tool Binaries (Leave blank to search system PATH)
JADX_PATH=
APKTOOL_PATH=
YARA_PATH=
TESSERACT_PATH=
EXIFTOOL_PATH=
TSHARK_PATH=
SURICATA_PATH=
OPENCODE_PATH=opencode.cmd

# Optional Passive Threat Intelligence APIs (Passive queries only; leave blank if unused)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
URLHAUS_API_KEY=
MALWAREBAZAAR_API_KEY=
SHODAN_API_KEY=
IPINFO_API_KEY=

# Optional AI Observation Providers (BYOK)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
