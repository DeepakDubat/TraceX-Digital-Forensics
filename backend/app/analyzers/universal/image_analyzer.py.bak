import io
import base64
from pathlib import Path
from datetime import datetime
from typing import Dict, Any, List, Tuple, Optional
from PIL import Image, ExifTags

from backend.app.core.models import ExtractedArtifact, FindingRecord

def _calculate_dhash(image: Image.Image, hash_size: int = 8) -> str:
    """
    Computes difference hash (dHash) for visual perceptual similarity.
    Compares adjacent pixel gradients across an (hash_size + 1, hash_size) grayscale grid.
    """
    try:
        resized = image.convert("L").resize((hash_size + 1, hash_size), Image.Resampling.LANCZOS)
        diff = []
        for row in range(hash_size):
            for col in range(hash_size):
                p_left = resized.getpixel((col, row))
                p_right = resized.getpixel((col + 1, row))
                diff.append("1" if p_left > p_right else "0")
        binary_str = "".join(diff)
        return hex(int(binary_str, 2))[2:].zfill(hash_size * hash_size // 4)
    except Exception:
        return ""

def _calculate_ahash(image: Image.Image, hash_size: int = 8) -> str:
    """
    Computes average hash (aHash) based on mean luminance comparison.
    """
    try:
        resized = image.convert("L").resize((hash_size, hash_size), Image.Resampling.LANCZOS)
        pixels = list(resized.getdata())
        avg = sum(pixels) / len(pixels)
        binary_str = "".join("1" if p > avg else "0" for p in pixels)
        return hex(int(binary_str, 2))[2:].zfill(hash_size * hash_size // 4)
    except Exception:
        return ""

def _convert_gps_to_degrees(value) -> Optional[float]:
    """Helper to convert the GPS coordinates stored in the EXIF to degrees in float format"""
    try:
        d = float(value[0])
        m = float(value[1])
        s = float(value[2])
        return d + (m / 60.0) + (s / 3600.0)
    except Exception:
        return None

def analyze_image_evidence(
    file_path: Path,
    evidence_id: str,
    investigation_id: str
) -> Tuple[Dict[str, Any], List[ExtractedArtifact], List[FindingRecord]]:
    """
    Forensic image analysis:
    - Dimensions, format, color mode
    - Full EXIF tag extraction
    - GPS coordinates extraction (latitude, longitude, altitude)
    - Perceptual image hashing (dHash, aHash) for cross-image similarity
    - Base64 thumbnail generation
    - Integrity and parser validation
    """
    artifacts: List[ExtractedArtifact] = []
    findings: List[FindingRecord] = []
    metadata: Dict[str, Any] = {
        "format": "image",
        "width": 0,
        "height": 0,
        "mode": "Unknown",
        "color_profile": "Standard",
        "exif": {},
        "gps": None,
        "dhash": "",
        "ahash": "",
        "thumbnail_data_url": None,
        "warnings": []
    }

    try:
        with Image.open(file_path) as img:
            w, h = img.size
            metadata["width"] = w
            metadata["height"] = h
            metadata["mode"] = img.mode
            metadata["image_format"] = img.format or file_path.suffix.lstrip(".").upper()

            # Compute perceptual hashes
            dhash = _calculate_dhash(img)
            ahash = _calculate_ahash(img)
            metadata["dhash"] = dhash
            metadata["ahash"] = ahash

            if dhash:
                artifacts.append(ExtractedArtifact(
                    id=f"ART-IMG-DHASH-{evidence_id}",
                    investigation_id=investigation_id,
                    evidence_id=evidence_id,
                    artifact_type="image_perceptual_hash",
                    source_format="image",
                    source_location="Image Pixel Grid (8x8 gradient)",
                    value=dhash,
                    structured_data={"algorithm": "dHash", "dhash": dhash, "ahash": ahash},
                    extractor_name="Perceptual Hasher",
                    confidence="Confirmed"
                ))

            # Generate Thumbnail
            thumb = img.copy()
            thumb.thumbnail((260, 260))
            buf = io.BytesIO()
            thumb.save(buf, format="PNG")
            b64 = base64.b64encode(buf.getvalue()).decode("ascii")
            metadata["thumbnail_data_url"] = f"data:image/png;base64,{b64}"

            # Extract EXIF tags
            raw_exif = img.getexif()
            if raw_exif:
                clean_exif = {}
                gps_info = {}
                for tag_id, value in raw_exif.items():
                    tag_name = ExifTags.TAGS.get(tag_id, str(tag_id))
                    if tag_name == "GPSInfo" and isinstance(value, dict):
                        for gps_tag_id, gps_val in value.items():
                            gps_tag_name = ExifTags.GPSTAGS.get(gps_tag_id, str(gps_tag_id))
                            gps_info[gps_tag_name] = str(gps_val)
                    else:
                        clean_exif[tag_name] = str(value)
                metadata["exif"] = clean_exif

                # Process GPS if present
                if gps_info:
                    lat_ref = gps_info.get("GPSLatitudeRef", "N")
                    lat_raw = raw_exif.get(34853, {}).get(2) if 34853 in raw_exif else None
                    lon_ref = gps_info.get("GPSLongitudeRef", "E")
                    lon_raw = raw_exif.get(34853, {}).get(4) if 34853 in raw_exif else None

                    lat = _convert_gps_to_degrees(lat_raw) if lat_raw else None
                    lon = _convert_gps_to_degrees(lon_raw) if lon_raw else None

                    if lat and lat_ref == "S":
                        lat = -lat
                    if lon and lon_ref == "W":
                        lon = -lon

                    if lat is not None and lon is not None:
                        metadata["gps"] = {
                            "latitude": round(lat, 6),
                            "longitude": round(lon, 6),
                            "raw": gps_info
                        }
                        artifacts.append(ExtractedArtifact(
                            id=f"ART-IMG-GPS-{evidence_id}",
                            investigation_id=investigation_id,
                            evidence_id=evidence_id,
                            artifact_type="gps_coordinates",
                            source_format="image",
                            source_location="EXIF GPSInfo Tag",
                            value=f"{lat:.6f}, {lon:.6f}",
                            structured_data={"latitude": lat, "longitude": lon, "tags": gps_info},
                            extractor_name="EXIF Geolocation Parser",
                            confidence="High"
                        ))
                        findings.append(FindingRecord(
                            id=f"FND-IMG-GPS-{evidence_id}",
                            investigation_id=investigation_id,
                            evidence_id=evidence_id,
                            artifact_ids=[f"ART-IMG-GPS-{evidence_id}"],
                            title="Embedded GPS Geolocation Metadata in Image",
                            description=f"The image file contains embedded geographic coordinates: Latitude {lat:.6f}, Longitude {lon:.6f}.",
                            observation=f"Found EXIF GPS metadata: Lat {lat:.6f}, Lon {lon:.6f}.",
                            interpretation="Identifies exact physical camera capture location. Essential evidentiary data for physical timeline and provenance.",
                            severity="Informational",
                            confidence="Confirmed",
                            analysis_method="EXIF Header Metadata Parsing",
                            source_location="Image EXIF Tags",
                            analyzer_name="Image Forensics Analyzer",
                            analyzer_version="1.0.0",
                            alternative_explanation="Standard device camera metadata recorded by mobile phone or digital camera."
                        ))

                # Camera Make / Model finding
                make = clean_exif.get("Make")
                model = clean_exif.get("Model")
                if make or model:
                    device_str = f"{make or ''} {model or ''}".strip()
                    artifacts.append(ExtractedArtifact(
                        id=f"ART-IMG-DEV-{evidence_id}",
                        investigation_id=investigation_id,
                        evidence_id=evidence_id,
                        artifact_type="camera_device_metadata",
                        source_format="image",
                        source_location="EXIF Make/Model Tags",
                        value=device_str,
                        structured_data={"make": make, "model": model},
                        extractor_name="EXIF Hardware Parser",
                        confidence="Confirmed"
                    ))

    except Exception as e:
        metadata["warnings"].append(f"Image structural analysis encountered error: {str(e)}")

    return metadata, artifacts, findings
