; Script generated for Universal Forensics Workbench
; Inno Setup 6 / 7 compatible script

#define MyAppName "Universal Forensics Workbench"
#define MyAppVersion "2.0.0"
#define MyAppPublisher "Digital Forensics & Threat Intelligence Lab"
#define MyAppURL "https://github.com/forensics-workbench/workbench"
#define MyAppExeName "ForensicsWorkbench.exe"
#define SourceDir "..\build\ForensicsWorkbench"

[Setup]
AppId={{9F5F32B7-6CE4-4E48-8E31-9DE0A7D84432}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\ForensicsWorkbench
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
OutputDir=..\dist
OutputBaseFilename=ForensicsWorkbench-Setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog
UninstallDisplayIcon={app}\{#MyAppExeName}
SetupIconFile=installer_assets\app_icon.ico

[Types]
Name: "standard"; Description: "Standard Installation (Recommended: Bundled Application, Runtimes, and Core Rule Sets)"; Flags: iscustom
Name: "minimal"; Description: "Minimal Installation (Application and Bundled Runtime Only)"

[Components]
Name: "core"; Description: "Universal Forensics Application & Bundled Python 3.11 Runtime"; Types: minimal standard; Flags: fixed
Name: "rules"; Description: "Production YARA Signatures & Android Malware Detection Rules"; Types: standard

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "startmenuicon"; Description: "Create Start Menu Shortcuts"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; Source directory is generated by PyInstaller into build/ForensicsWorkbench
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: core
Source: "tool_manifest.json"; DestDir: "{app}\installer"; Flags: ignoreversion; Components: core

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: startmenuicon
Name: "{group}\Universal Forensics Diagnostic Console"; Filename: "{app}\{#MyAppExeName}"; Parameters: "--headless"; Tasks: startmenuicon
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"; Tasks: startmenuicon
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
// Explicit check to preserve user forensic cases and evidence during uninstallation
function InitializeUninstall(): Boolean;
var
  DataDir: String;
begin
  Result := True;
  DataDir := ExpandConstant('{localappdata}\ForensicsWorkbench');
  if DirExists(DataDir) then
  begin
    MsgBox('Universal Forensics Workbench will now be uninstalled.' + #13#10#13#10 +
           'IMPORTANT: Your investigation cases, evidence files, and reports in:' + #13#10 +
           DataDir + #13#10#13#10 +
           'have been PRESERVED and will NOT be erased.', mbInformation, MB_OK);
  end;
end;
